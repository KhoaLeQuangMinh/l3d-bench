+def _l3d_val_dice(model, loader, device):
+    # [l3d-bench] Dice on the val folder with the same evaluation code as the released val loop
+    model.eval()
+    dices = []
+    with torch.no_grad():
+        for X_batch, depth, y_batch, name in loader:
+            output, _ = model(X_batch.to(device))
+            tmp = torch.argmax(torch.softmax(output, dim=1), dim=1)[0].cpu().numpy()
+            tmp2 = torch.argmax(y_batch.to(device), dim=1)[0].cpu().numpy()
+            pred = np.array([tmp == i for i in range(4)]).astype(np.uint8)
+            gt = np.array([tmp2 == i for i in range(4)]).astype(np.uint8)
+            dices.append(evaluation(pred[1:].flatten(), gt[1:].flatten())[1])
+    return float(np.mean(dices))
+
+
+def _l3d_save_resume(path, **state):
+    # [l3d-bench] atomic resume checkpoint, written after every epoch
+    state["rng"] = {"python": random.getstate(), "numpy": np.random.get_state(), "torch": torch.get_rng_state(),
+                    "cuda": torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None}
+    torch.save(state, path + ".tmp")
+    os.replace(path + ".tmp", path)
+
