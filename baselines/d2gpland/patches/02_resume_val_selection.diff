+def _l3d_val_dice(model, edge_prototypes_model, loader, device):
+    # [l3d-bench] Dice on the val folder with the same evaluation code as the released val loop
+    model.eval()
+    edge_prototypes_model.eval()
+    dices = []
+    with torch.no_grad():
+        for X_batch, depth, y_batch, name in loader:
+            prototypes = edge_prototypes_model()
+            output, feature, edge_out = model(X_batch.to(device), depth.to(device), prototypes)
+            tmp = torch.argmax(torch.softmax(output, dim=1), dim=1)[0].cpu().numpy()
+            tmp2 = torch.argmax(y_batch, dim=1)[0].numpy()
+            pred = np.array([tmp == i for i in range(4)]).astype(np.uint8)
+            gt = np.array([tmp2 == i for i in range(4)]).astype(np.uint8)
+            dices.append(evaluation(pred[1:].flatten(), gt[1:].flatten())[1])
+    return float(np.mean(dices))
+
